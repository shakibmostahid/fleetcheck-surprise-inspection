# Template for docker/.envs/app.env (copied automatically by `make` if missing).
# DATABASE_URL and TEST_DATABASE_URL are built from db.env by docker/api-entrypoint.sh.

# Fixed Basic auth credentials for the admin API (/admin/*).
# The seed creates a user with ADMIN_EMAIL so selections can record who triggered them.
ADMIN_EMAIL=admin@fleetcheck.test
ADMIN_PASSWORD=password123

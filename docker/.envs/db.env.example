# Template for docker/.envs/db.env (copied automatically by `make` if missing).
# Postgres credentials. The db container creates the database with them, and the
# api container builds DATABASE_URL / TEST_DATABASE_URL from them.
# Use letters and digits only (they are placed in a URL unescaped).
# Changing them after the first start needs `make clean` (deletes the database volume).
POSTGRES_USER=fleetcheck
POSTGRES_PASSWORD=fleetcheck
POSTGRES_DB=fleetcheck

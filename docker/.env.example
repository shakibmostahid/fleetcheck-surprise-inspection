# Template for docker/.env (copied automatically by `make` if missing).
# Docker Compose reads docker/.env itself.
# Application settings live in docker/.envs/app.env.
DB_PORT=5432
# Port the API listens on inside the container (passed to the app as PORT).
APP_PORT=3000
# Port on your machine (localhost) that forwards to APP_PORT.
LOCAL_PORT=3000
